# ---------------------------------------------------------------------------
# iTtEk POS Backend - environment variables. Copy to .env and adjust.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string
MONGODB_URI=mongodb://ittek:ittek_dev_password@localhost:27017/ittek_pos?authSource=admin

# Redis (used for caching / queues in later modules)
REDIS_URL=redis://localhost:6379

# JWT secrets - MUST be replaced with long random values in production
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# bcrypt work factor
BCRYPT_SALT_ROUNDS=12
