# ---------------------------------------------------------------------------
# iTtEk POS - root environment example (used by docker-compose).
# Copy to .env for `docker compose up`.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=ittek
MONGO_INITDB_ROOT_PASSWORD=ittek_dev_password
MONGO_PORT=27017

# --- Redis ---
REDIS_PORT=6379

# --- Unified app (serves web UI + API on one port) ---
APP_PORT=4000

# JWT secrets — MUST be long random values in production (>= 32 chars)
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars_x
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars_x
