# ---------------------------------------------------------------------------
# iTtEk POS - Root environment example.
# Copy to .env for docker-compose. App-specific envs live in apps/*/.env.
# ---------------------------------------------------------------------------

# --- Shared ---
NODE_ENV=development

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=ittek
MONGO_INITDB_ROOT_PASSWORD=ittek_dev_password
MONGO_PORT=27017

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=4000

# --- Frontend ---
FRONTEND_PORT=3000
